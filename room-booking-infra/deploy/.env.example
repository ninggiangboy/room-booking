# Copy to .env on the target host (never commit the filled-in file -- rule 2,
# room-booking-infra/docs/conventions.md). One set of values per environment: dev, staging, and
# production each get their own .env on their own host, filled in independently. See
# room-booking-infra/docs/configuration-and-secrets.md.

# Which environment this is. Tags every OTLP signal so the central Grafana can filter by it.
DEPLOY_ENV=dev

# The image to run, set by the deploy step (release.yml / promote.yml) -- normally you do not edit
# this by hand. ghcr.io/<org>/room-booking-backend:<commit-sha>
IMAGE_TAG=

# PostgreSQL. This environment's own database -- never shared with another environment.
POSTGRES_DB=room_booking
POSTGRES_USER=room_booking
POSTGRES_PASSWORD=

# MinIO.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Application secrets. Never reuse the dev-only values baked into
# room-booking-backend/src/main/resources/application-local.properties -- those are public by
# design. Generate fresh values per environment.
JWT_SECRET=
SECRET_BOX_KEY=

# Real SMTP provider. Mailpit does not exist past the local environments.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# This environment's own public hostname. Caddy requests a certificate for it, proxies application
# traffic to it, and publishes this environment's metrics-scrape path under it (see caddy/Caddyfile).
APP_HOSTNAME=
EMAIL_VERIFICATION_URL=https://${APP_HOSTNAME}/verify-email
PASSWORD_RESET_URL=https://${APP_HOSTNAME}/reset-password

# --- The central observability host (room-booking-infra/observability/) ---
# Every deployed environment points at the same one; see docs/platform-architecture.md and
# docs/observability.md's "two public ingestion hostnames".

# Outbound: this environment's application pushes OTLP traces/metrics/logs here. Precompute the
# header value once as `Basic $(printf '%s:%s' "$user" "$pass" | base64)`.
OTLP_ENDPOINT=https://otel.observability.example.com
OTLP_AUTH_HEADER=Basic __BASE64_USERNAME_COLON_PASSWORD__
# Sampling below 1.0 in every deployed environment -- see room-booking-infra/docs/observability.md.
OTLP_SAMPLE_RATE=0.1
# Metrics arrive by scrape here, not push -- see caddy/Caddyfile and docs/observability.md. Leave
# this false in every deployed environment; only the local environments push metrics.
OTLP_METRICS_PUSH_ENABLED=false

# Outbound: this environment's Postgres/MinIO/postgres-exporter containers ship logs here via the
# Docker loki logging driver, which takes basic-auth credentials embedded directly in the URL.
LOKI_PUSH_URL=https://user:pass@loki.observability.example.com/loki/api/v1/push

# Inbound: the central Prometheus scrapes THIS environment's own Caddy for the application's
# /actuator/prometheus, the Postgres exporter, and MinIO's metrics endpoint (caddy/Caddyfile). This
# credential is what Caddy checks -- it must match what the central Prometheus's per-environment
# scrape job is configured with on the observability host. SCRAPE_AUTH_PASSWORD_HASH is a
# Caddy-format bcrypt hash (docker run --rm caddy:2.10.2 caddy hash-password --plaintext '<password>');
# double every literal `$` in it to `$$` -- see observability/.env.example for why this matters.
SCRAPE_AUTH_USERNAME=
SCRAPE_AUTH_PASSWORD_HASH=
