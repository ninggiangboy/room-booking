# Copy to .env on the observability host (never commit the filled-in file -- rule 2,
# room-booking-infra/docs/conventions.md).

# Three public hostnames, each pointed at this host in DNS -- see caddy/Caddyfile.
OTEL_HOSTNAME=otel.observability.example.com
LOKI_HOSTNAME=loki.observability.example.com
GRAFANA_HOSTNAME=grafana.observability.example.com

# Checked by Caddy for both ingestion hostnames (OTLP push and Loki push). One shared credential
# across signals to start -- see docs/platform-architecture.md. Every deployed environment's
# OTLP_AUTH_HEADER / LOKI_PUSH_URL (room-booking-infra/deploy/.env) must carry this same username
# and password. INGEST_AUTH_PASSWORD_HASH is a Caddy-format bcrypt hash, generated with:
#   docker run --rm caddy:2.10.2 caddy hash-password --plaintext '<password>'
# IMPORTANT: double every literal `$` in the hash to `$$` here -- Docker Compose's .env parsing
# treats a single `$` as the start of variable interpolation (confirmed empirically: an unescaped
# bcrypt hash like `$2a$14$...` silently became an empty string, with only a easy-to-miss
# "variable is not set" warning as the clue). The same escaping applies to SCRAPE_AUTH_PASSWORD_HASH
# in every deployed environment's own .env (room-booking-infra/deploy/.env.example).
INGEST_AUTH_USERNAME=
INGEST_AUTH_PASSWORD_HASH=

# Grafana's own login -- not basic auth, Grafana authenticates itself.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
